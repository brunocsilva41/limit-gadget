{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LimitGadget",
  "version": "0.5.0",
  "identifier": "com.bruno.limitgadget",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "LimitGadget",
        "width": 316,
        "height": 112,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "../icons/32x32.png",
      "../icons/128x128.png",
      "../icons/128x128@2x.png",
      "../icons/icon.png",
      "../icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "PortugueseBR"
        ],
        "customLanguageFiles": {
          "PortugueseBR": "../installer/PortugueseBR.nsh"
        },
        "displayLanguageSelector": false,
        "installerIcon": "../icons/icon.ico",
        "uninstallerIcon": "../icons/icon.ico",
        "headerImage": "../installer/header.bmp",
        "uninstallerHeaderImage": "../installer/header.bmp",
        "sidebarImage": "../installer/sidebar.bmp",
        "installerHooks": "../installer/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdDREJFRDkwNEQ2MDA4NTUKUldSVkNHQk5rTzNiZkJ6endWa0pjQmJSWm1leFlsczEwejBhNXhBb2M0RkxSdG42bmxhc0xqQWQK"
    }
  }
}
